{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@root/*": ["./*"],
      "@model/*": ["./models/*"],
      "@module/*": ["./modules/*"],
      "@service/*": ["./services/*"],
      "@validator/*": ["./validators/*"],
      "@webhook/*": ["./webhooks/*"]
    }
  },
  "include": ["**/*.js"]
}
